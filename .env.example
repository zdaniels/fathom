# Fathom AI Configuration
# Copy this to .env and fill in your values

# LLM Provider (openai | anthropic | ollama)
FANTAZM_LLM_PROVIDER=openai
FANTAZM_LLM_MODEL=gpt-4o

# API Keys
# Preferred: store these in the encrypted vault with
#   fathom vault set ANTHROPIC_API_KEY
# .env is read as a fallback for compatibility, but the vault is the canonical
# source — `fathom vault import-env` migrates existing keys here over.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (local models)
# FANTAZM_LLM_PROVIDER=ollama
# FANTAZM_LLM_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# Server
FANTAZM_HOST=127.0.0.1
FANTAZM_PORT=8790
FANTAZM_LOG_LEVEL=info
FANTAZM_DATA_DIR=./data

# Auth
FANTAZM_AUTH_MODE=token
FANTAZM_SESSION_TIMEOUT=3600

# Enterprise (optional)
# FANTAZM_ENTERPRISE_ENABLED=true
# FANTAZM_OIDC_ISSUER=https://login.company.com
# FANTAZM_OIDC_CLIENT_ID=
# FANTAZM_OIDC_CLIENT_SECRET=
